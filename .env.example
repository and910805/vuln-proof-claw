VULN_PROOF_CLAW_APP__ENVIRONMENT=development
VULN_PROOF_CLAW_APP__DEBUG=false
VULN_PROOF_CLAW_API__HOST=127.0.0.1
VULN_PROOF_CLAW_API__PORT=8080
VULN_PROOF_CLAW_API__AUTHENTICATION_READY=false
VULN_PROOF_CLAW_DATABASE__URL=postgresql+psycopg://vuln_proof_claw:vuln_proof_claw@127.0.0.1:5432/vuln_proof_claw
VULN_PROOF_CLAW_DATABASE__POOL_SIZE=5
VULN_PROOF_CLAW_DATABASE__ECHO=false
VULN_PROOF_CLAW_DOCKER__WORKER_IMAGE=vuln-proof-claw-worker:dev
VULN_PROOF_CLAW_DOCKER__WORKER_NETWORK=vuln-proof-claw-workers
VULN_PROOF_CLAW_DOCKER__DEFAULT_TIMEOUT_SECONDS=300
VULN_PROOF_CLAW_LOGGING__LEVEL=INFO
VULN_PROOF_CLAW_LOGGING__FORMAT=human
# Keep real credentials in a secret manager or an untracked local .env file.
VULN_PROOF_CLAW_PROVIDER__NAME=openai-compatible
VULN_PROOF_CLAW_PROVIDER__BASE_URL=
VULN_PROOF_CLAW_PROVIDER__MODEL=
VULN_PROOF_CLAW_PROVIDER__API_KEY=

# Docker Compose local-development database values.
POSTGRES_DB=vuln_proof_claw
POSTGRES_USER=vuln_proof_claw
POSTGRES_PASSWORD=vuln_proof_claw_dev
