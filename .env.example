VULN_PROOF_CLAW_APP__ENVIRONMENT=development
VULN_PROOF_CLAW_APP__DEBUG=false
VULN_PROOF_CLAW_API__HOST=127.0.0.1
VULN_PROOF_CLAW_API__PORT=8080
VULN_PROOF_CLAW_API__AUTHENTICATION_READY=false
# When enabling authentication, inject distinct random tokens of at least 32 characters.
# VULN_PROOF_CLAW_API__OPERATOR_IDENTITY=operator@example.test
# VULN_PROOF_CLAW_API__APPROVER_IDENTITY=security-lead@example.test
# VULN_PROOF_CLAW_API__EVIDENCE_READER_IDENTITY=evidence-reader@example.test
# VULN_PROOF_CLAW_API__OPERATOR_TOKEN=
# VULN_PROOF_CLAW_API__APPROVER_TOKEN=
# Optional, but required before raw evidence or report content can be downloaded.
# VULN_PROOF_CLAW_API__EVIDENCE_READER_TOKEN=
# Passive target traffic is disabled until explicitly enabled.
VULN_PROOF_CLAW_ASSESSMENT__ENABLED=false
VULN_PROOF_CLAW_ASSESSMENT__TIMEOUT_SECONDS=10
VULN_PROOF_CLAW_ASSESSMENT__MAX_RESPONSE_BYTES=1048576
VULN_PROOF_CLAW_ASSESSMENT__USER_AGENT=vuln-proof-claw/0.0.17
VULN_PROOF_CLAW_DATABASE__URL=postgresql+psycopg://vuln_proof_claw:vuln_proof_claw@127.0.0.1:5432/vuln_proof_claw
VULN_PROOF_CLAW_DATABASE__POOL_SIZE=5
VULN_PROOF_CLAW_DATABASE__ECHO=false
VULN_PROOF_CLAW_DOCKER__WORKER_IMAGE=vuln-proof-claw-worker:dev
VULN_PROOF_CLAW_DOCKER__WORKER_NETWORK=vuln-proof-claw-workers
VULN_PROOF_CLAW_DOCKER__DEFAULT_TIMEOUT_SECONDS=300
# Keep disabled until a dedicated, authenticated Engine gateway and digest-pinned image exist.
VULN_PROOF_CLAW_DOCKER__RUNTIME_ENABLED=false
VULN_PROOF_CLAW_DOCKER__MAXIMUM_MEMORY_MEGABYTES=2048
VULN_PROOF_CLAW_DOCKER__MAXIMUM_CPU_COUNT=2
VULN_PROOF_CLAW_DOCKER__MAXIMUM_PROCESS_LIMIT=256
VULN_PROOF_CLAW_DOCKER__MAXIMUM_REQUEST_BYTES=262144
VULN_PROOF_CLAW_DOCKER__MAXIMUM_OUTPUT_BYTES=1048576
VULN_PROOF_CLAW_DOCKER__TASK_TMPFS_MEGABYTES=64
VULN_PROOF_CLAW_DOCKER__STOP_GRACE_SECONDS=5
# Required with RUNTIME_ENABLED=true. Use HTTPS, or an explicit loopback IP for local development.
# VULN_PROOF_CLAW_ENGINE_GATEWAY__URL=https://engine.example.test
# Inject a distinct random token of 32-4096 characters from a secret manager.
# VULN_PROOF_CLAW_ENGINE_GATEWAY__TOKEN=
VULN_PROOF_CLAW_ENGINE_GATEWAY__TIMEOUT_SECONDS=10
VULN_PROOF_CLAW_ENGINE_GATEWAY__MAXIMUM_RESPONSE_BYTES=2097152
# Optional private CA bundle for the Engine gateway.
# VULN_PROOF_CLAW_ENGINE_GATEWAY__CA_BUNDLE=/run/secrets/engine-ca.pem
# Privileged Engine server is a separate process and remains disabled by default.
VULN_PROOF_CLAW_ENGINE_SERVER__ENABLED=false
VULN_PROOF_CLAW_ENGINE_SERVER__HOST=127.0.0.1
VULN_PROOF_CLAW_ENGINE_SERVER__PORT=8081
# Required only when ENABLED=true; inject the same distinct secret used by the client.
# VULN_PROOF_CLAW_ENGINE_SERVER__TOKEN=
VULN_PROOF_CLAW_ENGINE_SERVER__MAXIMUM_REQUEST_BYTES=2097152
VULN_PROOF_CLAW_ENGINE_SERVER__MAXIMUM_CONCURRENT_OPERATIONS=16
VULN_PROOF_CLAW_ENGINE_SERVER__QUEUE_TIMEOUT_SECONDS=2
VULN_PROOF_CLAW_LOGGING__LEVEL=INFO
VULN_PROOF_CLAW_LOGGING__FORMAT=human
# Keep real credentials in a secret manager or an untracked local .env file.
VULN_PROOF_CLAW_PROVIDER__NAME=openai-compatible
VULN_PROOF_CLAW_PROVIDER__BASE_URL=
VULN_PROOF_CLAW_PROVIDER__MODEL=
VULN_PROOF_CLAW_PROVIDER__API_KEY=

# Docker Compose local-development database values.
POSTGRES_DB=vuln_proof_claw
POSTGRES_USER=vuln_proof_claw
POSTGRES_PASSWORD=vuln_proof_claw_dev
